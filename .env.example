APP_NAME="NexVex"
APP_ENV=local
APP_KEY=base64:1t2wZiqwpfX+LtPQG3qsUyIXqFdGPValZuX//eYi+ds=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Used as default CORS origin when CORS_ALLOWED_ORIGINS is empty (Vite dev server default port).
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Use mariadb if your server is MariaDB (e.g. XAMPP) — fixes db:show vs performance_schema on MySQL driver.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
# 3306 = typical local MySQL (XAMPP/WAMP often passwordless root). 33063 = docker-compose.yml (root / capstonedb).
DB_PORT=3306
DB_DATABASE=sp_capstone_db
DB_USERNAME=root
# Required if MySQL user is not passwordless. Use quotes for special characters: DB_PASSWORD="s#ecret"
# Or leave empty and put the password in database/.dbpass (one line, gitignored) — see database/dbpass.example.txt
DB_PASSWORD=
# Optional: if DB_PASSWORD is empty, Laravel uses this (e.g. PowerShell: $env:MYSQL_PASSWORD='secret'; php artisan serve)
MYSQL_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Realtime (chat): php artisan reverb:start — listens on REVERB_SERVER_PORT (default 8080)
REVERB_ENABLED=true
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# Production (with Redis): CACHE_STORE=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Comma-separated origins; leave empty to use FRONTEND_URL only.
CORS_ALLOWED_ORIGINS=*
# Set true for cookie/session Sanctum SPA on the same browser.
CORS_SUPPORTS_CREDENTIALS=true

SANCTUM_TOKEN_EXPIRATION_MINUTES=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:3000,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000,::1

BRAND_LOGO_URL=
BRAND_SUPPORT_EMAIL=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_ENABLED=true
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Sentiment AI (C:\Users\HP\ai\ai-service — python train_model.py && python app.py, port 5001)
AI_SERVICE_URL=http://127.0.0.1:5001
AI_SERVICE_TIMEOUT=120

FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2

BACKUP_ARCHIVE_PASSWORD=  

GOOGLE_MAPS_API_KEY=AIzaSyDY-kM6c0uNaZBtcCY-wtGR4lm3Ek2F-1Y

# Fix cURL error 60 (SSL: unable to get local issuer certificate) on Windows: download
# https://curl.se/ca/cacert.pem , save it locally, then set the path (use forward slashes or escaped backslashes):
# HTTP_CLIENT_CA_BUNDLE="C:/php/extras/ssl/cacert.pem"
# Alternatively, set curl.cainfo and openssl.cafile in php.ini to the same file.

# Local models via Ollama (RECO chatbot — customer & admin)
# Low RAM: ollama pull llama3.2:1b and set LLAMA_MODEL=llama3.2:1b
LLAMA_API_URL=http://localhost:11434
LLAMA_MODEL=llama3.2:3b
# chat = native /api/chat. anthropic = POST /v1/messages (Claude-compatible API shape on Ollama; same local LLAMA_MODEL).
LLAMA_OLLAMA_PROTOCOL=chat
# Optional tuning (conversation quality)
LLAMA_TEMPERATURE=0.65
LLAMA_TOP_P=0.9
LLAMA_MAX_TOKENS=500
LLAMA_CHAT_HISTORY_MAX=12

# Chatbot: merge last N user messages for intent (follow-ups like "in Beirut")
CHATBOT_INTENT_USER_MESSAGES_MAX=4
# Pool size before distance sort when customer sends lat/lng
CHATBOT_DISTANCE_CANDIDATE_LIMIT=40
# Public Google Maps Text Search from chat (POIs not on NexVex). Needs GOOGLE_MAPS_API_KEY with Places API.
CHATBOT_GOOGLE_TEXT_SEARCH=false
CHATBOT_GOOGLE_TEXT_MAX=5
# CHATBOT_GOOGLE_SEARCH_CACHE_SECONDS=3600
# CHATBOT_GOOGLE_SEARCH_RADIUS_M=25000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"
APP_TIMEZONE=UTC


